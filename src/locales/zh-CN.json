      "footer": "如有其他问题，请随时联系我们的客服。",
      "tipLabel": "💡 提示",
      "sections": {
        "basic": {
          "title": "基本用法",
          "steps": {
            "1": {
              "title": "创建日程",
              "description": "点击日历上的日期创建新日程。输入标题、时间、地点和备注，然后保存。",
              "tips": "长按可创建跨天日程。"
            },
            "2": {
              "title": "编辑和删除日程",
              "description": "点击现有日程打开详情页面。使用编辑按钮修改内容，或使用删除按钮删除日程。"
            },
            "3": {
              "title": "切换月、周、日视图",
              "description": "使用屏幕顶部的按钮更改显示格式。选择最适合您需求的视图。"
            }
          }
        },
        "calendar": {
          "title": "日历管理",
          "steps": {
            "1": {
              "title": "创建新日历",
              "description": "从侧边栏点击「创建日历」。您可以为家庭、工作、个人等不同用途管理独立的日历。",
              "tips": "为日历设置不同颜色以便视觉区分。"
            },
            "2": {
              "title": "切换日历",
              "description": "在侧边栏中点击日历名称以切换显示的日历。您也可以同时显示多个日历。"
            },
            "3": {
              "title": "更改日历设置",
              "description": "点击日历名称旁的「⋮」图标以重命名、更改颜色、删除或配置其他设置。"
            }
          }
        },
        "member": {
          "title": "成员邀请",
          "steps": {
            "1": {
              "title": "如何邀请成员",
              "description": "从日历设置中选择「邀请成员」。您可以通过二维码或邀请链接邀请其他用户。"
            },
            "2": {
              "title": "通过二维码邀请",
              "description": "点击「通过二维码邀请」以显示二维码。让您想邀请的人扫描此代码。",
              "tips": "二维码有有效期。请在有效期内完成邀请。"
            },
            "3": {
              "title": "复制邀请链接",
              "description": "使用「复制邀请链接」将邀请 URL 复制到剪贴板。通过电子邮件或消息应用分享。"
            }
          }
        },
        "notifications": {
          "title": "通知设置",
          "steps": {
            "1": {
              "title": "设置推送通知",
              "description": "在设置界面中打开「推送通知」以在日程开始时接收通知。",
              "tips": "您还需要在设备设置中允许应用通知。"
            },
            "2": {
              "title": "今日日程通知",
              "description": "从设置中的「今日日程」可以在指定时间接收每日日程通知。"
            },
            "3": {
              "title": "自定义通知时间",
              "description": "创建日程时，您可以单独设置通知时间（提前5分钟、15分钟、1小时等）。"
            }
          }
        },
        "display": {
          "title": "显示设置",
          "steps": {
            "1": {
              "title": "切换到深色模式",
              "description": "在设置中打开「深色模式」以将整个应用更改为深色主题。保护眼睛并节省电量。"
            },
            "2": {
              "title": "显示六曜",
              "description": "在设置中打开「六曜」以显示传统的日本历法标记，如大安和佛灭。"
            },
            "3": {
              "title": "设置每周起始日",
              "description": "在设置中选择星期从星期日或星期一开始。根据您的喜好进行配置。"
            }
          }
        },
        "advanced": {
          "title": "高级功能",
          "steps": {
            "1": {
              "title": "假日显示设置",
              "description": "从设置中的「假日」，您可以使用 Google Calendar API 显示准确的假日信息。"
            },
            "2": {
              "title": "更改时区",
              "description": "从设置中的「时区」更改当前时区。在国外居住或出差时很有用。"
            },
            "3": {
              "title": "个人资料设置",
              "description": "点击侧边栏中的个人资料部分以设置您的姓名和头像。"
            }
          }
        },
        "tips": {
          "title": "实用技巧",
          "steps": {
            "1": {
              "title": "手势控制",
              "description": "左右滑动以导航月份，上下滑动以更改显示格式。"
            },
            "2": {
              "title": "使用搜索功能",
              "description": "当您有很多日程时，使用搜索功能可快速找到特定的日程。"
            },
            "3": {
              "title": "备份和数据同步",
              "description": "如果您已登录账户，您的数据会自动保存到云端并在设备间同步。",
              "tips": "在多个设备上使用同一账户将自动同步您的数据。"
            }
          }
        }
      }
    }
